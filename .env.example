# ============================================================================
# AI Influencer Workstation — your keys and settings
#
# Easiest:  python custom_nodes/ai_influencer_toolkit/tools/configure.py
# By hand:  copy this file to `.env` and fill in the values you need.
#
# `.env` is gitignored and must never be committed or shared: every key below
# is a bearer credential that spends your money. Only fill in what you use.
# The full list lives in custom_nodes/ai_influencer_toolkit/env_config.py.
# ============================================================================

# --- Cloud workflows 01-05 (Krea, GPT Image, Seedance via ComfyUI partner nodes)
# One Comfy account key covers all of them; there are no per-provider keys.
# Only needed for scripted queuing (tools/queue_workflow.py): in the browser,
# signing in to your Comfy account in the ComfyUI menu is enough.
# https://platform.comfy.org/login
COMFY_API_KEY=
COMFY_API_BASE_URL=https://api.comfy.org
COMFY_SERVER_URL=http://127.0.0.1:8188

# --- Character used when a node's "project" field is blank
# (folder name under input/ai_influencer/ and output/projects/)
AI_INFLUENCER_DEFAULT_PROJECT=

# --- Krea 2 version for the local workflows (07-10, 09b, 12): fp8 | gguf | nvfp4 | bf16
# fp8 = standard, 12 GB+ cards; gguf = low memory, 8 GB cards (installs the ComfyUI-GGUF add-on);
# nvfp4 = small, RTX 50-series only; bf16 = full quality, 40 GB+.
# Easiest to set in ComfyUI: Extensions menu -> AI Influencer: Models.
AI_INFLUENCER_KREA_VERSION=fp8

# --- fal.ai LoRA training / generation (Workflow 06, train_lora.py, eval_lora.py)
# https://fal.ai/dashboard/keys
FAL_KEY=
# Refuse fal.ai jobs estimated above this many dollars (0 = no limit)
FAL_BUDGET_USD=0

# --- Rented GPU pods on vast.ai (vast_pod.py, comfy_pod.py, the Pod queue)
# https://cloud.vast.ai/manage-keys/
VAST_API_KEY=
# Hugging Face token with WRITE access: downloads gated Krea 2 and moves the
# dataset, checkpoints and pod kit through a private HF dataset repo.
# https://huggingface.co/settings/tokens
HF_TOKEN=
# That private repo as user/name. Blank = <your HF user>/<project>-lora-transfer
AI_INFLUENCER_HF_REPO=
# Trained LoRA inside that repo that the ComfyUI pod loads, e.g.
# results/<instance id>/<name>_000002500.safetensors (vast_pod.py watch prints it)
AI_INFLUENCER_LORA_PATH=
